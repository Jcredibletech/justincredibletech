---
// Pre-network section URLs (/category/<old>/) now forward to the matching network section page.
// Vercel also 301s these via vercel.json; this page covers the GitHub Pages mirror.
import { LEGACY_SECTION, sectionUrl } from '../../utils/posts';
import { CANONICAL_ORIGIN } from '../../consts';
export function getStaticPaths() {
  return ['health', 'cars', 'space', 'science', 'ai', 'tech', 'news'].map((section) => ({ params: { section } }));
}
const { section } = Astro.params;
const target = sectionUrl(LEGACY_SECTION[section!] ?? 'tech');
const canonical = new URL(`/${LEGACY_SECTION[section!] ?? 'tech'}/`, CANONICAL_ORIGIN).href;
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><title>Moved</title><link rel="canonical" href={canonical} /><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0; url=${target}`} /></head>
<body><p>This section moved to <a href={target}>{canonical}</a>.</p></body></html>
