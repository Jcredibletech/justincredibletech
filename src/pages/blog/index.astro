---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Story from '../../components/Story.astro';
import { getPosts } from '../../utils/posts';
const posts = await getPosts();
---
<BaseLayout title="Latest stories" description="Every JustinCredibleTech story, newest first: tech, AI, cars and EVs, space, science and health.">
  <div class="container">
    <header class="page-hero"><span class="eyebrow">Archive</span><h1>Latest stories</h1><p>Everything we've published, newest first.</p></header>
    <div class="list">{posts.map((p, i) => <Story post={p} variant="row" eager={i < 2} />)}</div>
  </div>
</BaseLayout>
<style>
  .list { display: grid; gap: 2rem; margin-top: 2rem; max-width: 980px; }
  .list > :global(*) { padding-bottom: 2rem; border-bottom: 1px solid var(--line); }
</style>
