---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/inter';
import '@fontsource/saira/900-italic.css';
import '../styles/global.css';
type Props = import('../components/BaseHead.astro').Props & { sectionSlug?: string };
const { sectionSlug, ...props } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...props} />
  </head>
  <body class={sectionSlug ? `sec-scope sec-${sectionSlug}` : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header sectionSlug={sectionSlug} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
