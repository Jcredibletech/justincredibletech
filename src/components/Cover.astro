---
import { imageFor, sectionFor, type Post } from '../utils/posts';
import { responsiveImage } from '../utils/seo';
interface Props { post: Post; eager?: boolean; sizes?: string; }
const { post, eager = false, sizes } = Astro.props;
const img = imageFor(post);
const sec = sectionFor(post);
const resp = img ? await responsiveImage(img) : undefined;
const imgSizes = sizes ?? (eager ? '(max-width: 1000px) 100vw, 60vw' : '(max-width: 640px) 100vw, (max-width: 1000px) 50vw, 33vw');
---
<div class={`cover sec-${sec.slug}`} style={`--sec-fill:${sec.colorTag}`}>
  {img ? (
    <img src={img} srcset={resp?.srcset} sizes={resp ? imgSizes : undefined} width={resp?.width} height={resp?.height} alt={post.data.imageAlt ?? ''} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
  ) : (
    <div class="cover-fallback" aria-hidden="true">
      <span class="cf-sec">{sec.name}</span>
      <span class="cf-mark">JC<b>{sec.short}</b></span>
    </div>
  )}
</div>
<style>
  .cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); background: var(--surface-2); }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  :global(a:hover) .cover img { transform: scale(1.03); }
  .cover-fallback {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 1rem 1.1rem;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--sec-fill) 55%, transparent) 0%, transparent 60%),
      linear-gradient(135deg, #15161a 0%, #23252b 100%);
    color: #fff;
  }
  .cf-sec { font: 700 .72rem/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--sec-fill); }
  .cf-mark { align-self: flex-end; font: 900 clamp(2rem, 6vw, 3.4rem)/1 var(--font-sans); letter-spacing: -.05em; opacity: .9; }
  .cf-mark b { color: var(--sec-fill); margin-left: .12em; }
</style>
