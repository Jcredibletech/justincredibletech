---
import { imageFor, sectionFor, type Post } from '../utils/posts';
interface Props { post: Post; eager?: boolean; sizes?: string; }
const { post, eager = false } = Astro.props;
const img = imageFor(post);
const sec = sectionFor(post);
---
<div class="cover" style={`--sec:${sec.color}`}>
  {img ? (
    <img src={img} alt={post.data.imageAlt ?? ''} loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : 'auto'} />
  ) : (
    <div class="cover-fallback" aria-hidden="true">
      <span class="cf-sec">{sec.name}</span>
      <span class="cf-mark">JC<b>T</b></span>
    </div>
  )}
</div>
<style>
  .cover { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--radius); background: var(--surface-2); }
  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s ease; }
  :global(a:hover) .cover img { transform: scale(1.03); }
  .cover-fallback {
    position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; padding: 1rem 1.1rem;
    background:
      radial-gradient(120% 90% at 100% 0%, color-mix(in srgb, var(--sec) 55%, transparent) 0%, transparent 60%),
      linear-gradient(135deg, #15161a 0%, #23252b 100%);
    color: #fff;
  }
  .cf-sec { font: 700 .72rem/1 var(--font-sans); letter-spacing: .14em; text-transform: uppercase; color: var(--sec); }
  .cf-mark { align-self: flex-end; font: 900 clamp(2rem, 6vw, 3.4rem)/1 var(--font-sans); letter-spacing: -.05em; opacity: .9; }
  .cf-mark b { color: #c9a227; }
</style>
