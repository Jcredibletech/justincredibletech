---
import { SECTIONS, sectionUrl } from '../utils/posts';
import { withBase } from '../utils/paths';
import { TAG_X, TAG_Y, TAG_H, LOCKUP_H, lockupViewBoxWidth, MASTER_ACCENT } from '../utils/lockup';

interface Props {
  /** Current section slug. Omitted on the homepage / About / blog index: the tag reads SECTIONS. */
  slug?: string;
}

const { slug } = Astro.props;
const isHome = !slug;
const current = isHome ? undefined : SECTIONS.find((s) => s.slug === slug);
const label = isHome ? 'SECTIONS' : (current?.short ?? 'SECTIONS').toUpperCase();
const accent = isHome ? MASTER_ACCENT : (current?.colorDark ?? MASTER_ACCENT);
const vbW = lockupViewBoxWidth(label, true);
const homeHref = withBase('');
const allDot = `conic-gradient(${SECTIONS.map((s, i) => `${s.colorDark} ${i * 45}deg ${(i + 1) * 45}deg`).join(', ')})`;
---
<details
  class="sec-switcher"
  style={`--tag:${accent}; --vb-w:${vbW}; --tag-x:${TAG_X}; --tag-y:${TAG_Y}; --tag-h:${TAG_H}; --lockup-vb-h:${LOCKUP_H}`}
>
  <summary aria-haspopup="menu" aria-expanded="false" aria-controls="sec-switcher-menu" aria-label={isHome ? 'Browse sections' : `Current section: ${current?.name}. Browse sections`}>
    <span class="tag-inner">
      <span class="tag-label">{label}</span>
      <svg class="tag-chevron" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="M1 1.2 L6 6.2 L11 1.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </summary>
  <div class="sec-menu" id="sec-switcher-menu" role="menu" aria-label="JustinCredible sections">
    <a href={homeHref} role="menuitem" aria-current={isHome ? 'page' : undefined}>
      <span class="dot" style={`background:${allDot}`} aria-hidden="true"></span>
      All stories
    </a>
    <div class="sec-menu-rule" aria-hidden="true"></div>
    {SECTIONS.map((s) => (
      <a href={sectionUrl(s.slug)} role="menuitem" aria-current={slug === s.slug ? 'page' : undefined}>
        <span class="dot" style={`background:${s.colorDark}`} aria-hidden="true"></span>
        {s.name}
      </a>
    ))}
  </div>
</details>
<style>
  .sec-switcher {
    position: absolute;
    left: calc(var(--tag-x) / var(--vb-w) * 100%);
    top: calc(var(--tag-y) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    height: calc(var(--tag-h) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    z-index: 8;
  }
  .sec-switcher summary {
    list-style: none;
    cursor: pointer;
    height: 100%;
    display: flex;
    align-items: stretch;
    background: var(--tag, var(--brand-gold));
    color: #0B1426;
    border: 0;
    padding: 0;
    margin: 0;
    /* Slant matches the original parallelogram tag (~7.23px over 34px ≈ 12°). */
    transform: skewX(-12deg);
    transform-origin: top left;
  }
  .sec-switcher summary::-webkit-details-marker,
  .sec-switcher summary::marker { display: none; content: none; }
  .tag-inner {
    transform: skewX(12deg);
    display: inline-flex;
    align-items: center;
    gap: .22em;
    padding: 0 .42em 0 .5em;
    height: 100%;
    font-family: Saira, sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: calc(var(--lockup-h, 56px) * 26 / 120);
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }
  /* Expand the hit target without changing the visible tag. */
  .sec-switcher summary::after {
    content: '';
    position: absolute;
    inset: -10px -8px;
  }
  .tag-chevron { flex: none; display: block; }
  .sec-switcher[open] .tag-chevron { transform: rotate(180deg); }
  .sec-switcher summary:focus-visible {
    outline: 2px solid var(--tag, var(--brand-gold));
    outline-offset: 3px;
  }

  .sec-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    min-width: 17.5rem;
    background: var(--surface, #fff);
    color: var(--text);
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 16px 40px color-mix(in srgb, #0B1426 18%, transparent);
    padding: .35rem 0;
    z-index: 30;
  }
  .sec-menu a {
    display: flex;
    align-items: center;
    gap: .7rem;
    padding: .55rem 1rem;
    color: var(--text);
    text-decoration: none;
    font: 650 .92rem/1.2 var(--font-sans);
    letter-spacing: 0;
    text-transform: none;
    border: 0;
    background: transparent;
    width: 100%;
    box-sizing: border-box;
  }
  .sec-menu a:hover,
  .sec-menu a:focus-visible {
    background: var(--surface-2);
    outline: none;
  }
  .sec-menu a[aria-current='page'] { font-weight: 800; }
  .dot {
    width: .7rem;
    height: .7rem;
    border-radius: 2px;
    flex: none;
  }
  .sec-menu-rule { height: 1px; background: var(--line); margin: .3rem 0; }

  @media (max-width: 900px) {
    .sec-menu {
      position: fixed;
      left: 0;
      right: 0;
      top: var(--switcher-bottom, 8.5rem);
      min-width: 0;
      width: 100%;
      border-radius: 0 0 10px 10px;
      max-height: min(70vh, 28rem);
      overflow: auto;
      box-shadow: 0 18px 40px color-mix(in srgb, #0B1426 28%, transparent);
    }
  }
</style>
