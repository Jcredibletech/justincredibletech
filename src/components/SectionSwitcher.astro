---
import { SECTIONS, sectionUrl } from '../utils/posts';
import { TAG_X, TAG_Y, TAG_H, LOCKUP_H, lockupViewBoxWidth, MASTER_ACCENT, tagInk } from '../utils/lockup';

interface Props {
  /** Current section slug. Omitted on the homepage / About / blog index: the tag reads TECH. */
  slug?: string;
}

const { slug } = Astro.props;
const homeIsTech = !slug;
const currentSlug = slug ?? 'tech';
const current = SECTIONS.find((s) => s.slug === currentSlug) ?? SECTIONS[0];
const label = current.short.toUpperCase();
const accent = current.colorTag ?? MASTER_ACCENT;
const ink = tagInk(accent);
const vbW = lockupViewBoxWidth(label, true);
const others = SECTIONS.filter((s) => s.slug !== currentSlug);
const ariaLabel = homeIsTech
  ? 'Current section: JustinCredible Tech. Browse sections'
  : `Current section: ${current.name}. Browse sections`;
---
<details
  class="sec-switcher"
  style={`--tag:${accent}; --tag-ink:${ink}; --vb-w:${vbW}; --tag-x:${TAG_X}; --tag-y:${TAG_Y}; --tag-h:${TAG_H}; --lockup-vb-h:${LOCKUP_H}`}
>
  <summary aria-haspopup="menu" aria-expanded="false" aria-controls="sec-switcher-menu" aria-label={ariaLabel}>
    <span class="tag-inner">
      <span class="tag-label">{label}</span>
      <svg class="tag-chevron" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="M1 1.2 L6 6.2 L11 1.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </summary>
  <div class="sec-menu" id="sec-switcher-menu" role="menu" aria-label="JustinCredible sections">
    {others.map((s, i) => (
      <a
        href={sectionUrl(s.slug)}
        role="menuitem"
        style={`--tag:${s.colorTag}; --tag-ink:${tagInk(s.colorTag)}; --delay:${40 + i * 28}ms`}
      ><span class="tag-inner">{s.short.toUpperCase()}</span></a>
    ))}
  </div>
</details>
<style>
  .sec-switcher {
    position: absolute;
    left: calc(var(--tag-x) / var(--vb-w) * 100%);
    top: calc(var(--tag-y) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    height: calc(var(--tag-h) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    z-index: 40;
  }
  .sec-switcher summary {
    list-style: none;
    cursor: pointer;
    height: 100%;
    display: flex;
    align-items: stretch;
    background: var(--tag, var(--brand-gold));
    color: var(--tag-ink, #0B1426);
    border: 0;
    padding: 0;
    margin: 0;
    transform: skewX(-12deg);
    transform-origin: top left;
    position: relative;
    z-index: 1;
  }
  .sec-switcher summary::-webkit-details-marker,
  .sec-switcher summary::marker { display: none; content: none; }
  .tag-inner {
    transform: skewX(12deg);
    display: inline-flex;
    align-items: center;
    gap: .22em;
    padding: 0 .42em 0 .5em;
    height: 100%;
    font-family: Saira, sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: calc(var(--lockup-h, 56px) * 26 / 120);
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }
  /* Expand the hit target without changing the visible tag. */
  .sec-switcher summary::after {
    content: '';
    position: absolute;
    inset: -10px -8px -4px;
  }
  .tag-chevron { flex: none; display: block; }
  .sec-switcher[open] .tag-chevron { transform: rotate(180deg); }
  .sec-switcher summary:focus-visible {
    outline: 2px solid var(--tag, var(--brand-gold));
    outline-offset: 3px;
  }

  .sec-menu {
    position: absolute;
    /* Sit just under the lockup (clear CREDIBLE) so the stack hangs off the tag, not over the wordmark. */
    top: calc(100% + (120 - var(--tag-y) - var(--tag-h)) / var(--lockup-vb-h) * var(--lockup-h, 56px) + 4px);
    left: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    background: transparent;
    border: 0;
    box-shadow: none;
    padding: 0;
    margin: 0;
    min-width: 0;
    width: max-content;
    z-index: 41;
  }
  .sec-menu a {
    display: flex;
    align-items: center;
    height: calc(var(--tag-h) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    padding: 0;
    margin: 0;
    background: var(--tag);
    color: var(--tag-ink, #fff);
    text-decoration: none;
    border: 0;
    box-shadow: none;
    width: auto;
    box-sizing: border-box;
    transform: skewX(-12deg);
    transform-origin: top left;
  }
  .sec-menu a:hover,
  .sec-menu a:focus-visible {
    filter: brightness(1.08);
    outline: 2px solid var(--tag-ink, #fff);
    outline-offset: 2px;
  }
  .sec-menu a .tag-inner { padding: 0 .58em 0 .55em; }
  .sec-switcher[open] .sec-menu a {
    animation: tag-drop .2s ease-out both;
    animation-delay: var(--delay, 0ms);
  }
  @keyframes tag-drop {
    from { opacity: 0; transform: skewX(-12deg) translateY(-6px); }
    to { opacity: 1; transform: skewX(-12deg) translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .sec-menu a .tag-inner { padding: 0 .58em 0 .55em; }
  .sec-switcher[open] .sec-menu a { animation: none; }
  }
</style>
