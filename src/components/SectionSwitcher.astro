---
import { SECTIONS, sectionUrl } from '../utils/posts';
import { TAG_X, TAG_Y, TAG_H, LOCKUP_H, lockupViewBoxWidth, MASTER_ACCENT, tagInk, tagWidth } from '../utils/lockup';

interface Props {
  /** Current section slug. Omitted on the homepage / About / blog index: the tag reads TECH. */
  slug?: string;
}

const { slug } = Astro.props;
const homeIsTech = !slug;
const currentSlug = slug ?? 'tech';
const current = SECTIONS.find((s) => s.slug === currentSlug) ?? SECTIONS[0];
const label = current.short.toUpperCase();
const accent = current.colorTag ?? MASTER_ACCENT;
const ink = tagInk(accent);
const vbW = lockupViewBoxWidth(label, true);
const others = SECTIONS.filter((s) => s.slug !== currentSlug);
const menuW = Math.max(tagWidth(label), ...SECTIONS.map((s) => tagWidth(s.short)));
/** Dropdown chips always use white type; slightly darker fills where the bar color would fail contrast. */
const MENU_FILL: Partial<Record<string, string>> = { ev: '#0e7490' };
const ariaLabel = homeIsTech
  ? 'Current section: JustinCredible Tech. Browse sections'
  : `Current section: ${current.name}. Browse sections`;
---
<details
  class="sec-switcher"
  style={`--tag:${accent}; --tag-ink:${ink}; --vb-w:${vbW}; --tag-x:${TAG_X}; --tag-y:${TAG_Y}; --tag-h:${TAG_H}; --lockup-vb-h:${LOCKUP_H}; --menu-w: calc(${menuW} / ${LOCKUP_H} * var(--lockup-h, 56px))`}
>
  <summary aria-haspopup="menu" aria-expanded="false" aria-controls="sec-switcher-menu" aria-label={ariaLabel}>
    <span class="tag-inner">
      <span class="tag-label">{label}</span>
      <svg class="tag-chevron" viewBox="0 0 12 8" width="10" height="7" aria-hidden="true"><path d="M1 1.2 L6 6.2 L11 1.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </span>
  </summary>
  <div class="sec-menu" id="sec-switcher-menu" role="menu" aria-label="JustinCredible sections">
    {others.map((s, i) => (
      <a
        href={sectionUrl(s.slug)}
        role="menuitem"
        style={`--tag:${MENU_FILL[s.slug] ?? s.colorTag}; --delay:${30 + i * 22}ms`}
      ><span class="tag"><span class="tag-inner">{s.short.toUpperCase()}</span></span></a>
    ))}
  </div>
</details>
<style>
  .sec-switcher {
    position: absolute;
    left: calc(var(--tag-x) / var(--vb-w) * 100%);
    top: calc(var(--tag-y) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    height: calc(var(--tag-h) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    z-index: 40;
  }
  .sec-switcher[open] { z-index: 80; }
  .sec-switcher summary {
    list-style: none;
    cursor: pointer;
    height: 100%;
    display: flex;
    align-items: stretch;
    background: var(--tag, var(--brand-gold));
    color: var(--tag-ink, #0B1426);
    border: 0;
    padding: 0;
    margin: 0;
    transform: skewX(-12deg);
    transform-origin: top left;
    position: relative;
    z-index: 1;
  }
  .sec-switcher summary::-webkit-details-marker,
  .sec-switcher summary::marker { display: none; content: none; }
  .tag-inner {
    transform: skewX(12deg);
    display: inline-flex;
    align-items: center;
    gap: .22em;
    padding: 0 .42em 0 .5em;
    height: 100%;
    font-family: Saira, sans-serif;
    font-weight: 900;
    font-style: italic;
    font-size: calc(var(--lockup-h, 56px) * 26 / 120);
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    user-select: none;
  }
  /* Expand the hit target without changing the visible tag. */
  .sec-switcher summary::after {
    content: '';
    position: absolute;
    inset: -10px -8px -4px;
  }
  .tag-chevron { flex: none; display: block; }
  .sec-switcher[open] .tag-chevron { transform: rotate(180deg); }
  .sec-switcher summary:focus-visible {
    outline: 2px solid var(--tag, var(--brand-gold));
    outline-offset: 3px;
  }

  .sec-menu {
    --inset: 7px;
    --gap: 3px;
    --tag-h-css: calc(var(--tag-h) / var(--lockup-vb-h) * var(--lockup-h, 56px));
    --skew-pad: calc(var(--tag-h-css) * tan(12deg) + 1px);
    position: absolute;
    top: calc(100% + 5px);
    left: calc(-1 * (var(--inset) + var(--skew-pad)));
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--gap);
    box-sizing: border-box;
    padding: var(--inset);
    padding-left: calc(var(--inset) + var(--skew-pad));
    width: calc(var(--menu-w) + (var(--inset) * 2) + var(--skew-pad));
    min-width: calc(var(--menu-w) + (var(--inset) * 2) + var(--skew-pad));
    margin: 0;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 6px;
    box-shadow:
      0 1px 2px color-mix(in srgb, #0B1426 8%, transparent),
      0 8px 22px color-mix(in srgb, #0B1426 16%, transparent);
    z-index: 81;
  }
  :global([data-theme='dark']) .sec-menu {
    box-shadow:
      0 1px 2px color-mix(in srgb, #000 40%, transparent),
      0 10px 26px color-mix(in srgb, #000 50%, transparent);
  }
  .sec-switcher[open] .sec-menu {
    animation: panel-in .18s ease-out;
  }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: none; }
  }

  /* Row is the slim tag height; ::after expands the tap target to ~32px without opening the stack. */
  .sec-menu a {
    position: relative;
    display: flex;
    align-items: stretch;
    width: 100%;
    height: var(--tag-h-css);
    padding: 0;
    margin: 0;
    background: transparent;
    color: #fff;
    text-decoration: none;
    border: 0;
    box-sizing: border-box;
  }
  .sec-menu a::after {
    content: '';
    position: absolute;
    left: -6px;
    right: -6px;
    top: 50%;
    height: 32px;
    transform: translateY(-50%);
    z-index: 0;
  }
  .sec-menu a .tag {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: stretch;
    width: 100%;
    height: 100%;
    background: var(--tag);
    color: #fff;
    transform: skewX(-12deg);
    transform-origin: top left;
    transition: filter .15s ease, box-shadow .15s ease;
  }
  .sec-menu a .tag-inner {
    padding: 0 .42em 0 .5em;
    width: 100%;
    justify-content: flex-start;
    color: #fff;
  }
  .sec-menu a:hover .tag,
  .sec-menu a:focus-visible .tag {
    filter: brightness(1.12);
    box-shadow: 0 1px 4px color-mix(in srgb, #0B1426 22%, transparent);
  }
  .sec-menu a:focus-visible {
    outline: none;
  }
  .sec-menu a:focus-visible .tag {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .sec-switcher[open] .sec-menu a {
    animation: row-in .2s ease-out both;
    animation-delay: var(--delay, 0ms);
  }
  @keyframes row-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sec-switcher[open] .sec-menu,
    .sec-switcher[open] .sec-menu a { animation: none; }
    .sec-menu a .tag { transition: none; }
  }
</style>
