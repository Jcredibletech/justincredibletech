---
import { SITE_TITLE, SITE_DESCRIPTION, SITE_AUTHOR, CANONICAL_ORIGIN } from '../consts';
import { withBase } from '../utils/paths';
import { metaDescription, pageTitle as buildTitle, imageSize } from '../utils/seo';
import { REACTIONS_API } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  pubDate?: Date;
  updatedDate?: Date;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}
const { title, description: rawDescription = SITE_DESCRIPTION, image, type = 'website', pubDate, updatedDate, section, tags = [], jsonLd, noindex } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rel = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
const canonicalURL = new URL(rel, CANONICAL_ORIGIN).href;
const isMirror = !CANONICAL_ORIGIN.startsWith(String(Astro.site).replace(/\/$/, ''));
const imgPath = image ?? '/og-default.png';
const imgRel = imgPath.startsWith(base) && base ? imgPath.slice(base.length) : imgPath;
const ogImage = /^https?:/.test(imgPath) ? imgPath : new URL(imgRel, CANONICAL_ORIGIN).href;
const pageTitle = buildTitle(title, `${SITE_TITLE}: Tech, AI, Auto, Space, EV, Science, Health & Politics News`);
const description = metaDescription(rawDescription);
const ogDims = image && !/^https?:/.test(image) ? await imageSize(image) : undefined;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{isMirror && <meta http-equiv="refresh" content={`0; url=${canonicalURL}`} />}
{noindex && <meta name="robots" content="noindex" />}
<meta name="author" content={SITE_AUTHOR} />
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
{type === 'article' && <link rel="preconnect" href={REACTIONS_API} crossorigin />}
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0f1013" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href={withBase('favicon.ico')} sizes="any" />
<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
<link rel="icon" type="image/png" sizes="32x32" href={withBase('favicon-32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={withBase('favicon-16.png')} />
<link rel="apple-touch-icon" sizes="180x180" href={withBase('apple-touch-icon.png')} />
<link rel="manifest" href={withBase('site.webmanifest')} />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-title" content="JustinCredible" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<script is:inline>if('serviceWorker' in navigator && location.hostname==='justincredibletech.com'){addEventListener('load',()=>navigator.serviceWorker.register('/sw.js'))}</script>
{/* Vercel Web Analytics (free Hobby tier, cookie-free). Official domain only; the GitHub Pages mirror just redirects. */}
{!isMirror && <script is:inline>window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };</script>}
{!isMirror && <script is:inline defer src="/_vercel/insights/script.js"></script>}
<link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} RSS`} href={withBase('rss.xml')} />
<link rel="sitemap" href={withBase('sitemap-index.xml')} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title ?? SITE_TITLE} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
{ogDims && <meta property="og:image:width" content={String(ogDims.width)} />}
{ogDims && <meta property="og:image:height" content={String(ogDims.height)} />}
<meta property="og:image:alt" content={title ?? `${SITE_TITLE} logo`} />
<meta property="og:locale" content="en_US" />
{pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}
{section && <meta property="article:section" content={section} />}
{tags.map((t) => <meta property="article:tag" content={t} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@JCredibleTech" />
<meta name="twitter:creator" content="@JCredibleTech" />
<meta name="twitter:title" content={title ?? SITE_TITLE} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
<script is:inline>
  (function () {
    try {
      var t = localStorage.getItem('jct-theme');
      if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      document.documentElement.dataset.theme = t;
    } catch (e) {}
  })();
</script>
