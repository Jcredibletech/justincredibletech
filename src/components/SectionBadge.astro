---
import { getSection, sectionUrl } from '../utils/posts';
interface Props { slug: string; size?: 'sm' | 'lg'; link?: boolean; }
const { slug, size = 'sm', link = true } = Astro.props;
const s = getSection(slug);
const Tag = link ? 'a' : 'span';
---
<Tag class={`sec-badge sec-${s.slug}${size === 'lg' ? ' sec-badge--lg' : ''}`} href={link ? sectionUrl(s.slug) : undefined} aria-label={s.name}><span class="jc" aria-hidden="true"><svg class="mini-mark" viewBox="0 0 512 512" width="16" height="16"><path fill="currentColor" d="M94 16H418L496 94V418L418 496H94L16 418V94Z"/><path fill="#0B1426" d="M110 44H402L468 110V402L402 468H110L44 402V110Z"/><g transform="translate(144.8,143.5) scale(2.25)"><g fill="currentColor" transform="skewX(-12)"><path d="M16 0H62V80L42 100H0V60H26V74H36V26H16Z"/><path d="M92 0H138V34H112V26H96V74H112V66H138V100H92L70 78V22Z"/><path d="M-14 31H30V39H-18Z"/><path d="M-6 44H30V52H-10Z"/></g></g></svg></span><span class="nm">{s.short}</span></Tag>
