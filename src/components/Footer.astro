---
import { SECTIONS } from '../utils/posts';
import { withBase } from '../utils/paths';
import { SOCIALS, SITE_DESCRIPTION } from '../consts';
import { SOCIAL_ICONS } from '../utils/socialIcons';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container foot-grid">
    <div>
      <a class="foot-mark" href={withBase('')} aria-label="JustinCredibleTech home"><img src={withBase('brand/jc-header-dark.svg')} alt="JustinCredible Tech" width="490" height="120" loading="lazy" /></a>
      <p class="foot-blurb">{SITE_DESCRIPTION}</p>
    </div>
    <nav aria-label="Sections">
      <h4>Sections</h4>
      <ul>{SECTIONS.map((s) => <li><a href={withBase(`category/${s.slug}/`)}>{s.name}</a></li>)}</ul>
    </nav>
    <nav aria-label="More">
      <h4>Follow</h4>
      <ul class="social-icons">
        {SOCIALS.map((s) => (
          <li><a href={s.url} rel="noopener" target="_blank" aria-label={`Follow on ${s.name}`} title={`${s.name} · ${s.label}`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={SOCIAL_ICONS[s.icon]} fill="currentColor" /></svg></a></li>
        ))}
        <li><a href={withBase('rss.xml')} aria-label="RSS feed" title="RSS feed" class="rss"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={SOCIAL_ICONS.rss} fill="currentColor" /></svg></a></li>
      </ul>
      <ul class="follow-more"><li><a href={withBase('about/')}>About</a></li></ul>
    </nav>
  </div>
  <div class="container foot-base">© {year} JustinCredibleTech. Independent coverage; no politics.</div>
</footer>
<style>
  .site-footer { margin-top: 4rem; background: var(--ink); color: #d8d8dc; padding: 3rem 0 1.5rem; }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 2rem; }
  @media (max-width: 720px) { .foot-grid { grid-template-columns: 1fr 1fr; } .foot-grid > div:first-child { grid-column: 1 / -1; } }
  .site-footer { background: #0B1426; }
  .foot-mark { display: inline-block; line-height: 0; }
  .foot-mark img { height: 48px; width: auto; }
  .foot-blurb { color: #a4a6ad; max-width: 34rem; font-size: .92rem; line-height: 1.55; }
  h4 { font: 800 .72rem/1 var(--font-sans); text-transform: uppercase; letter-spacing: .14em; color: #D8B03A; margin: 0 0 .9rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: .55rem; }
  a { color: #d8d8dc; text-decoration: none; font: 500 .92rem/1.2 var(--font-sans); } a:hover { color: #fff; }
  .foot-base { margin-top: 2.5rem; padding-top: 1.2rem; border-top: 1px solid #2c2e34; color: #8a8d95; font: 500 .8rem/1.4 var(--font-sans); }
  .social-icons { display: flex; flex-wrap: wrap; gap: .7rem; }
  .social-icons a { display: inline-flex; align-items: center; justify-content: center; width: 40px; height: 40px; border-radius: 50%; background: #1a2540; color: #fff; transition: background .15s; }
  .social-icons a:hover { background: #26345a; }
  .social-icons a.rss { color: #FFA500; }
  .follow-more { margin-top: 1rem; }
</style>
