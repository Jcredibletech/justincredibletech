---
import { withBase } from '../utils/paths';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <p class="copy">© {year} JustinCredibleTech</p>
    <p class="footer-note muted">
      Built by Justin McBroom · Companion long-form to{' '}
      <a href="https://x.com/JCredibleTech" rel="noopener noreferrer">@JCredibleTech</a>
    </p>
    <nav aria-label="Footer">
      <a href={withBase('blog')}>Blog</a>
      <a href={withBase('about')}>About</a>
      <a href={withBase('rss.xml')}>RSS</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .footer-inner {
    width: min(100% - 2rem, var(--max-width-wide));
    margin-inline: auto;
    padding-block: 1.5rem 2rem;
    display: grid;
    gap: 0.5rem;
  }

  .copy {
    margin: 0;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .footer-note {
    margin: 0;
    font-size: 0.92rem;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.35rem;
  }

  nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>
