---
import { SITE_TITLE, SITE_TAGLINE } from '../consts';
import { withBase } from '../utils/paths';

const base = import.meta.env.BASE_URL;
const baseNoSlash = base.replace(/\/$/, '') || '/';
const pathname = Astro.url.pathname.replace(/\/$/, '') || baseNoSlash;
const links = [
  { href: withBase(), label: 'Home' },
  { href: withBase('blog'), label: 'Blog' },
  { href: withBase('about'), label: 'About' },
];

function isActive(href: string) {
  const normalized = href.replace(/\/$/, '') || baseNoSlash;
  if (normalized === baseNoSlash) return pathname === baseNoSlash;
  return pathname === normalized || pathname.startsWith(`${normalized}/`);
}
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase()} aria-label={`${SITE_TITLE} home`}>
      <img src={withBase('logo.png')} width="44" height="44" alt="" class="brand-mark" />
      <span class="brand-text">
        <span class="brand-name">{SITE_TITLE}</span>
        <span class="brand-tagline">{SITE_TAGLINE}</span>
      </span>
    </a>
    <nav aria-label="Primary">
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <a class="nav-rss" href={withBase('rss.xml')}>RSS</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(26, 26, 26, 0.92);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    width: min(100% - 2rem, var(--max-width-wide));
    margin-inline: auto;
    padding-block: 0.85rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }

  .brand:hover {
    color: inherit;
  }

  .brand-mark {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid var(--color-gold);
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-name {
    font-weight: 800;
    letter-spacing: -0.03em;
    font-size: 1.15rem;
    color: var(--color-text);
  }

  .brand-tagline {
    font-size: 0.78rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: min(52vw, 28rem);
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav-list a:hover,
  .nav-list a[aria-current='page'] {
    color: var(--color-gold-soft);
    background: rgba(201, 162, 39, 0.1);
  }

  .nav-rss {
    color: var(--color-gold) !important;
  }

  @media (max-width: 560px) {
    .brand-tagline {
      display: none;
    }
  }
</style>
