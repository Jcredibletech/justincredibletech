---
import { SECTIONS, getSection, sectionUrl } from '../utils/posts';
import SectionLockup from './SectionLockup.astro';
import SectionSwitcher from './SectionSwitcher.astro';
interface Props { sectionSlug?: string; }
const { sectionSlug } = Astro.props;
import { withBase } from '../utils/paths';
import { SITE_X } from '../consts';
const path = Astro.url.pathname;
const today = new Date().toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Chicago' });
---
<header class="masthead" style={`--lockup:${sectionSlug ? getSection(sectionSlug).colorDark : '#d8b03a'}`}>
  <div class="topbar">
    <div class="container topbar-in">
      <span class="date">{today}</span>
      <nav class="topbar-links" aria-label="Utility">
        <a href={withBase('about/')}>About</a>
        <a href={withBase('rss.xml')}>RSS</a>
        <a href={SITE_X} rel="noopener">@JCredibleTech</a>
        <button class="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle dark mode">
          <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"/></g></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M20.5 14.6A8.5 8.5 0 0 1 9.4 3.5a8.5 8.5 0 1 0 11.1 11.1z"/></svg>
        </button>
      </nav>
    </div>
  </div>
  <div class="container brand-row">
    <div class="brand-lockup">
      <a class="wordmark" href={withBase('')} aria-label="JustinCredibleTech home">
        <SectionLockup slug={sectionSlug} reserveTag tagLabel={sectionSlug ? getSection(sectionSlug).short : 'SECTIONS'} />
      </a>
      <SectionSwitcher slug={sectionSlug} />
    </div>
  </div>
  {sectionSlug
    ? <div class="lockup-rule" aria-hidden="true"></div>
    : <div class="network-bar" aria-hidden="true">{SECTIONS.map((s) => <span style={`background:${s.colorDark}`}></span>)}</div>
  }
  <nav class="sections" aria-label="Sections">
    <div class="container sections-in">
      <div class="nav-core">
        <a href={withBase('')} aria-current={path === withBase('') ? 'page' : undefined}>Top Stories</a>
        <a href={withBase('blog/')} aria-current={path.startsWith(withBase('blog')) && path.length <= withBase('blog/').length ? 'page' : undefined}>Latest</a>
      </div>
      <div class="nav-secs">
        {SECTIONS.map((s) => (
          <a class={`sec-${s.slug} sec-link`} href={sectionUrl(s.slug)} aria-current={path.replace(/\/$/, '') === sectionUrl(s.slug).replace(/\/$/, '') ? 'page' : (sectionSlug === s.slug ? 'true' : undefined)} aria-label={s.name}><i aria-hidden="true"></i>{s.short}</a>
        ))}
      </div>
    </div>
  </nav>
</header>
<script is:inline>
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const d = document.documentElement;
    const next = d.dataset.theme === 'dark' ? 'light' : 'dark';
    d.dataset.theme = next;
    try { localStorage.setItem('jct-theme', next); } catch (e) {}
  });
  (function () {
    var cur = document.querySelector('.sections a.sec-link[aria-current]');
    var bar = document.querySelector('.nav-secs') || document.querySelector('.sections-in');
    if (cur && bar && bar.scrollWidth > bar.clientWidth) bar.scrollLeft = cur.offsetLeft - (bar.clientWidth - cur.offsetWidth) / 2;
  })();
  (function () {
    var root = document.querySelector('.sec-switcher');
    if (!root) return;
    var sum = root.querySelector('summary');
    var links = Array.prototype.slice.call(root.querySelectorAll('.sec-menu a'));
    function sync() {
      sum.setAttribute('aria-expanded', root.open ? 'true' : 'false');
      if (root.open) {
        var header = document.querySelector('.masthead');
        var bottom = header ? header.getBoundingClientRect().bottom : sum.getBoundingClientRect().bottom;
        document.documentElement.style.setProperty('--switcher-bottom', Math.round(bottom) + 'px');
      }
    }
    root.addEventListener('toggle', sync);
    sync();
    document.addEventListener('pointerdown', function (e) {
      if (root.open && !root.contains(e.target)) root.open = false;
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && root.open) {
        root.open = false;
        sum.focus();
        e.preventDefault();
        return;
      }
      if (!root.open) return;
      var i = links.indexOf(document.activeElement);
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        links[i < 0 ? 0 : (i + 1) % links.length].focus();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        links[i < 0 ? links.length - 1 : (i - 1 + links.length) % links.length].focus();
      } else if (e.key === 'Home') {
        e.preventDefault();
        links[0].focus();
      } else if (e.key === 'End') {
        e.preventDefault();
        links[links.length - 1].focus();
      }
    });
    sum.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (!root.open) root.open = true;
        (links[0] || sum).focus();
      }
    });
  })();
</script>
<style>
  .masthead { background: var(--bg); position: relative; z-index: 5; }
  .topbar { border-bottom: 1px solid var(--line); font: 500 .78rem/1 var(--font-sans); color: var(--muted); }
  .topbar-in { display: flex; justify-content: space-between; align-items: center; min-height: 2.25rem; gap: 1rem; }
  .topbar-links { display: flex; gap: 1.1rem; align-items: center; }
  .topbar-links a { color: var(--muted); text-decoration: none; }
  .topbar-links a:hover { color: var(--text); }
  .theme-toggle { border: 1px solid var(--line); background: transparent; color: var(--text); border-radius: 999px; width: 28px; height: 28px; display: grid; place-items: center; cursor: pointer; }
  .i-moon { display: none; } :global([data-theme='dark']) .i-moon { display: block; } :global([data-theme='dark']) .i-sun { display: none; }
  @media (max-width: 560px) { .date { display: none; } .topbar-in { justify-content: flex-end; } }

  .brand-row { display: flex; justify-content: center; padding: .75rem 0 .7rem; }
  .brand-lockup { position: relative; display: inline-block; --lockup-h: 56px; line-height: 0; }
  .lockup-rule { height: 3px; background: var(--lockup, var(--brand-gold)); }
  .network-bar { display: flex; height: 4px; }
  .network-bar span { flex: 1; min-width: 0; }
  .wordmark { display: inline-flex; align-items: center; text-decoration: none; line-height: 0; }
  @media (max-width: 560px) { .brand-row { padding: .6rem 0 .55rem; } .brand-lockup { --lockup-h: 46px; } }

  .sections { border-bottom: 1px solid var(--line); position: sticky; top: 0; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(10px); }
  .sections-in { display: flex; align-items: stretch; gap: 1.15rem; justify-content: center; }
  .nav-core, .nav-secs { display: contents; }
  .sections a { flex: none; padding: .85rem 0 .75rem; font: 700 .82rem/1 var(--font-sans); text-transform: uppercase; letter-spacing: .06em; color: var(--text); text-decoration: none; border-bottom: 3px solid transparent; }
  .sections a:hover, .sections a[aria-current] { border-bottom-color: var(--sec, var(--gold)); }
  .sec-link i { display: inline-block; width: .5rem; height: .5rem; border-radius: 2px; background: var(--sec); margin-right: .4rem; vertical-align: .05em; }
  .sections a.sec-link[aria-current] { color: var(--sec); }
  /* Short section labels (Tech, AI, Auto…) so eight items fit on one desktop row. */
  @media (max-width: 1320px) { .sections-in { gap: 1.05rem; } }

  /* Phones and narrow tablets: wrapping 4x2 color-coded chips, no sideways scroll. */
  @media (max-width: 900px) {
    .sections-in {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: .4rem;
      padding: .45rem 0 .55rem;
      overflow: visible;
    }
    .nav-core {
      display: flex;
      justify-content: center;
      gap: 1.25rem;
    }
    .nav-core a { padding: .4rem 0 .25rem; border-bottom-width: 2px; }
    .nav-secs {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: .35rem;
    }
    .nav-secs a.sec-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .28rem;
      margin: 0;
      padding: .48rem .15rem;
      border: 1px solid color-mix(in srgb, var(--sec) 42%, var(--line));
      border-radius: 999px;
      background: color-mix(in srgb, var(--sec) 11%, var(--bg));
      color: var(--sec);
      font-size: .68rem;
      letter-spacing: .04em;
      line-height: 1;
    }
    .nav-secs a.sec-link i { width: .42rem; height: .42rem; margin: 0; border-radius: 2px; }
    .nav-secs a.sec-link:hover,
    .nav-secs a.sec-link[aria-current] {
      background: var(--sec);
      color: var(--sec-ink);
      border-color: var(--sec);
      border-bottom-color: var(--sec);
    }
    .nav-secs a.sec-link[aria-current] i,
    .nav-secs a.sec-link:hover i { background: var(--sec-ink); }
  }
</style>
