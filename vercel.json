{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/justincredibletech",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/justincredibletech/(.*)",
      "destination": "/$1",
      "permanent": true
    },
    {
      "source": "/category/health",
      "destination": "/health/",
      "permanent": true
    },
    {
      "source": "/category/health/",
      "destination": "/health/",
      "permanent": true
    },
    {
      "source": "/category/cars",
      "destination": "/auto/",
      "permanent": true
    },
    {
      "source": "/category/cars/",
      "destination": "/auto/",
      "permanent": true
    },
    {
      "source": "/category/space",
      "destination": "/space/",
      "permanent": true
    },
    {
      "source": "/category/space/",
      "destination": "/space/",
      "permanent": true
    },
    {
      "source": "/category/science",
      "destination": "/science/",
      "permanent": true
    },
    {
      "source": "/category/science/",
      "destination": "/science/",
      "permanent": true
    },
    {
      "source": "/category/ai",
      "destination": "/ai/",
      "permanent": true
    },
    {
      "source": "/category/ai/",
      "destination": "/ai/",
      "permanent": true
    },
    {
      "source": "/category/tech",
      "destination": "/tech/",
      "permanent": true
    },
    {
      "source": "/category/tech/",
      "destination": "/tech/",
      "permanent": true
    },
    {
      "source": "/category/news",
      "destination": "/tech/",
      "permanent": true
    },
    {
      "source": "/category/news/",
      "destination": "/tech/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
